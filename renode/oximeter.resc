:name: medsec-oximeter
:description: The pulse oximeter (nRF52840 DK with a MAX30101) and a hub on a second nRF52840, joined by Bluetooth LE.

$oximeter_image?=$ORIGIN/../build/oximeter/app/zephyr/zephyr.signed.hex
$bootloader_bin?=$ORIGIN/../build/oximeter/mcuboot/zephyr/zephyr.elf
$hub_bin?=$ORIGIN/../build/hub/zephyr/zephyr.elf

# The models are compiled when they're loaded, so they have to come before the platform.
include $ORIGIN/Max30101.cs
include $ORIGIN/Nvmc.cs
include $ORIGIN/Ccm.cs

emulation CreateBLEMedium "wireless"

# Firmware is loaded once, as a factory programs the flash. A reset then starts whatever the flash
# holds, as on the chip, so an image MCUboot has swapped in stays there.
mach create "oximeter"
machine LoadPlatformDescription $ORIGIN/nrf52840dk-oximeter.repl
connector Connect sysbus.radio wireless
showAnalyzer sysbus.uart0
sysbus LoadHEX $oximeter_image
sysbus LoadELF $bootloader_bin

# The factory's step: the oximeter's limits key into UICR. Make it with tools/provision.py.
$provisioning?=$ORIGIN/../build/provision.resc
include $provisioning

mach create "hub"
machine LoadPlatformDescription $ORIGIN/nrf52840dk-hub.repl
connector Connect sysbus.radio wireless
showAnalyzer sysbus.uart0
sysbus LoadELF $hub_bin

# The two Bluetooth stacks need the machines kept within 10 us of each other.
emulation SetGlobalQuantum "0.00001"
